{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "whatsapp-clone-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-20",
  "workers_dev": true,
  "durable_objects": {
    "bindings": [{ "name": "CHAT", "class_name": "ChatService" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ChatService"] }],
  "observability": { "enabled": false }
}
