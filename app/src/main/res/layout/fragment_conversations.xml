<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
    <TextView android:id="@+id/emptyState" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:padding="24dp" android:gravity="center" android:text="@string/loading" android:textSize="16sp" />
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/conversations" android:layout_width="match_parent"
        android:layout_height="0dp" android:layout_weight="1" android:scrollbars="vertical" />
</LinearLayout>
